{
  "name": "the-game-is-afoot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "app",
    "pipeline"
  ],
  "scripts": {
    "dev": "npm run dev -w @afoot/app",
    "build": "npm run build -w @afoot/app",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p app/tsconfig.json && tsc --noEmit -p app/tsconfig.node.json",
    "test": "vitest run",
    "e2e": "node app/e2e/playthrough.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "afoot": "tsx pipeline/src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "1.64",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
